# Username e password amministratore. Non salvare credenziali nel repository.
CMS_USERNAME=
# In produzione, almeno 16 caratteri; usare una password robusta e unica.
CMS_PASSWORD=
# In alternativa a CMS_PASSWORD si può usare CMS_PASSWORD_HASH nel formato scrypt:salt:hash.
# CMS_PASSWORD_HASH=
# Directory persistente per contenuti e immagini. Fare backup regolari.
CMS_DATA_DIR=.cms-data
# Obbligatorio in produzione: origine HTTPS esatta del sito (senza percorso).
CMS_PUBLIC_ORIGIN=https://example.com
