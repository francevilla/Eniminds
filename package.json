{
  "name": "eniminds-redesign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n CMS,SITO \"npm run dev:api\" \"npm run dev:web\"",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "dev:web": "vite --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "vite": "^6.0.0"
  }
}
